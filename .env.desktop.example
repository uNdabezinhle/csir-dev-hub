# CSIR Dev Hub - Docker Desktop (Windows / macOS laptop) settings. scripts/start-desktop.ps1 copies this to .env.
COMPOSE_PROJECT_NAME=csir-devhub
DESKTOP_MODE=true
# Browser URLs are http://localhost:<port>; workspaces reach Coder via host.docker.internal (templates rewrite it).
HOST_IP=localhost
CODER_VERSION=v2.38.10
KEYCLOAK_VERSION=26.4
# Docker Desktop exposes /var/run/docker.sock as root:root 0660 inside containers
DOCKER_GID=0
CODER_PORT=3000
KEYCLOAK_PORT=8080
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
ADMIN_CONSOLE_PORT=8088
GUACAMOLE_PORT=8089
GUACAMOLE_ENABLED=true
# No KVM under Docker Desktop on Windows (no /dev/kvm): VM / Windows templates stay off.
KVM_ENABLED=false
# Workspace images to build + templates to push (start-desktop.ps1). Add kali if Docker has memory to spare.
DESKTOP_TEMPLATES="ubuntu-server ubuntu-desktop"
BACKUP_DIR=../csir-backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# Ubuntu 24.04 golden image for VM workspaces (templates/ubuntu-vm).
# Source: official Ubuntu cloud image (SHA256-verified) -> patched + base tooling + qemu-guest-agent -> cloud-init
# reset -> compressed qcow2 -> published to the libvirt "golden" pool by build.sh (scripts/kvm-publish-image.sh --file).
# accelerator = "kvm" on real KVM hosts; "tcg" on the PoC box (nested KVM unusable there).
packer {
  required_plugins {
    qemu = {
      source  = "github.com/hashicorp/qemu"
      version = "~> 1.1"
    }
  }
}

variable "accelerator" {
  type    = string
  default = "kvm"
}
variable "build_password" {
  type        = string
  sensitive   = true
  description = "Throw-away password of the temporary 'packer' build user (generated by build.sh, user deleted at the end)"
}
variable "seed_dir" {
  type = string
}
variable "upgrade" {
  type    = bool
  default = true
}
variable "output_dir" {
  type    = string
  default = "output"
}
variable "image_name" {
  type    = string
  default = "ubuntu-24.04-golden"
}

source "qemu" "ubuntu" {
  iso_url          = "https://cloud-images.ubuntu.com/releases/noble/release/ubuntu-24.04-server-cloudimg-amd64.img"
  iso_checksum     = "file:https://cloud-images.ubuntu.com/releases/noble/release/SHA256SUMS"
  disk_image       = true
  disk_size        = "10G"
  format           = "qcow2"
  disk_compression = true
  disk_interface   = "virtio"
  net_device       = "virtio-net"
  accelerator      = var.accelerator
  cpus             = 2
  memory           = 2048
  headless         = true
  cd_files         = ["${var.seed_dir}/user-data", "${var.seed_dir}/meta-data"]
  cd_label         = "cidata"
  ssh_username     = "packer"
  ssh_password     = var.build_password
  ssh_timeout      = "90m"
  shutdown_command = "echo '${var.build_password}' | sudo -S sh -c 'cloud-init clean --logs --seed; rm -f /etc/sudoers.d/90-packer; shutdown -P now'"
  output_directory = var.output_dir
  vm_name          = "${var.image_name}.qcow2"
}

build {
  sources = ["source.qemu.ubuntu"]

  provisioner "shell" {
    execute_command  = "echo '${var.build_password}' | sudo -S env {{ .Vars }} bash '{{ .Path }}'"
    environment_vars = ["UPGRADE=${var.upgrade}"]
    scripts          = ["scripts/base.sh", "scripts/cleanup.sh"]
  }

  post-processor "manifest" {
    output     = "${var.output_dir}/manifest.json"
    strip_path = true
  }
}

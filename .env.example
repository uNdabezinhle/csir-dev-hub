# Copy to .env and adjust (scripts/start.sh does this automatically on first run). Secrets go in secrets/devhub.env.
# Non-secret settings (committed). Secrets: secrets/devhub.env
COMPOSE_PROJECT_NAME=csir-devhub
# Address reachable by BOTH your browser and workspace containers.
# On this PoC box it is the docker0 gateway. On-prem: the server's LAN IP / DNS name.
HOST_IP=172.17.0.1
CODER_VERSION=v2.38.10
KEYCLOAK_VERSION=26.4
DOCKER_GID=996
CODER_PORT=3000
KEYCLOAK_PORT=8080
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
ADMIN_CONSOLE_PORT=8088
GUACAMOLE_PORT=8089
GUACAMOLE_ENABLED=true
# VM workspaces (docker-compose.kvm.yml): libvirt container. KVM_ACCEL=tcg on hosts where nested KVM is unusable (PoC box).
KVM_ENABLED=true
KVM_ACCEL=tcg
LIBVIRT_MEM_LIMIT=5g
# scripts/backup.sh target (outside the repo; contains secrets -> chmod 700)
BACKUP_DIR=/workspace/csir-backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
